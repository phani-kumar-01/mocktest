{
  "name": "nptel-mock-exam",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter \"@nptel/*\" build",
    "test": "vitest run",
    "typecheck": "pnpm --filter \"@nptel/*\" typecheck",
    "dev:api": "pnpm --filter @nptel/api dev",
    "dev:worker": "pnpm --filter @nptel/api dev:worker",
    "dev:web": "pnpm --filter @nptel/web dev",
    "db:generate": "pnpm --filter @nptel/api db:generate",
    "db:migrate": "pnpm --filter @nptel/api db:migrate",
    "seed": "pnpm --filter @nptel/api seed",
    "start": "pnpm --filter @nptel/api start"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.9",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.2",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4"
  }
}
